# Postgres (Coolify creates this for you)
DATABASE_URL=postgres://genesis:CHANGE_ME@db:5432/genesis

# Public URL of the app, no trailing slash
APP_URL=https://app.example.com

# Better Auth: long random string (openssl rand -base64 32)
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=https://app.example.com

# Telegram approvals (optional until the bot exists)
TELEGRAM_BOT_TOKEN=
# Chat id that receives approval requests (Javad's private chat with the bot)
TELEGRAM_ADMIN_CHAT_ID=
# Comma-separated Telegram user ids allowed to approve
TELEGRAM_ADMIN_USER_IDS=
# Random string; Telegram sends it back on every webhook call
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME

# n8n: every event is also POSTed here (optional)
N8N_EVENTS_WEBHOOK_URL=

# Only for docker-compose.db.yml (local bundled Postgres)
POSTGRES_PASSWORD=CHANGE_ME
SITE_NAME=Legend Partner

# ── Outbound (step 4, docs/outbound.md). Every key is optional: without it that step uses its free path.
# Who signs messages and makes calls
SALES_SENDER=Javad
# Company finder: Google Maps via Apify
APIFY_TOKEN=
# Decision-maker finder (test Italian coverage first)
APOLLO_API_KEY=
# Agent key for npm run agents:outbound on the server (scope crm:write); local mode makes its own
OUTBOUND_AGENT_KEY=
# Email: Brevo (EU). MAIL_FROM must be a verified sender in Brevo
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
# AI voice calls: Vapi (assistant, phone number and webhook set up in Vapi; switch on per country in the cockpit)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
# WhatsApp Business (Meta Cloud API); webhook URL: <APP_URL>/api/v1/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Claude price list, € per million tokens, for the cost of a customer
CLAUDE_EUR_PER_MTOK_IN=
CLAUDE_EUR_PER_MTOK_OUT=
