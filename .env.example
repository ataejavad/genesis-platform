# Postgres (Coolify creates this for you)
DATABASE_URL=postgres://genesis:CHANGE_ME@db:5432/genesis

# Public URL of the app, no trailing slash
APP_URL=https://app.example.com

# Better Auth: long random string (openssl rand -base64 32)
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=https://app.example.com

# Telegram approvals (optional until the bot exists)
TELEGRAM_BOT_TOKEN=
# Chat id that receives approval requests (Javad's private chat with the bot)
TELEGRAM_ADMIN_CHAT_ID=
# Comma-separated Telegram user ids allowed to approve
TELEGRAM_ADMIN_USER_IDS=
# Random string; Telegram sends it back on every webhook call
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME

# n8n: every event is also POSTed here (optional)
N8N_EVENTS_WEBHOOK_URL=

# Only for docker-compose.db.yml (local bundled Postgres)
POSTGRES_PASSWORD=CHANGE_ME
SITE_NAME=Legend Partner

# ── Outbound (step 4, docs/outbound.md). Every key is optional: without it that step uses its free path.
# Who signs messages and makes calls
SALES_SENDER=Javad
# Company finder: Google Maps via Apify
APIFY_TOKEN=
# Decision-maker finder (test Italian coverage first)
APOLLO_API_KEY=
# Agent key for npm run agents:outbound on the server (scope crm:write); local mode makes its own
OUTBOUND_AGENT_KEY=
# Email: Brevo (EU). MAIL_FROM must be a verified sender in Brevo
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
# AI voice calls: Vapi (assistant, phone number and webhook set up in Vapi; switch on per country in the cockpit)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
# WhatsApp Business (Meta Cloud API); webhook URL: <APP_URL>/api/v1/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Which company serves each outside service (src/providers/registry.ts). Leave empty = automatic: the vendor
# whose keys are set, else the free fallback. Changing company = set the switch + its keys; no code changes.
# LLM_PROVIDER=anthropic | gemini | openai-compatible | mock
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Google Gemini (test phase). Free tier may train on prompts: agents that see personal data stay off until GEMINI_PAID_TIER=1
GEMINI_API_KEY=
GEMINI_PAID_TIER=
# for openai-compatible (OpenAI, Mistral, OpenRouter, a local model …); LLM_MODEL also overrides the Claude model
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# € per million tokens of the active model, for the cost of a customer (default: Claude Opus list price)
LLM_EUR_PER_MTOK_IN=
LLM_EUR_PER_MTOK_OUT=
# EMAIL_PROVIDER=brevo | outbox | mock
EMAIL_PROVIDER=
# VOICE_PROVIDER=vapi | none | mock
VOICE_PROVIDER=
# ADMIN_CHAT_PROVIDER=telegram | none | mock
ADMIN_CHAT_PROVIDER=
# WHATSAPP_PROVIDER=meta | none
WHATSAPP_PROVIDER=
# COMPANY_SEARCH_PROVIDER=apify | import
COMPANY_SEARCH_PROVIDER=
# PEOPLE_SEARCH_PROVIDER=apollo | none
PEOPLE_SEARCH_PROVIDER=
# STORAGE_PROVIDER=local (FILES_DIR); PAYMENTS_PROVIDER=bank-transfer; EINVOICE_PROVIDER=manual; VAT_CHECK_PROVIDER=vies
STORAGE_PROVIDER=
PAYMENTS_PROVIDER=
EINVOICE_PROVIDER=
