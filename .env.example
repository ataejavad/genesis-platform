# Postgres (Coolify creates this for you)
DATABASE_URL=postgres://genesis:CHANGE_ME@db:5432/genesis

# Public URL of the app, no trailing slash
APP_URL=https://app.example.com

# Better Auth: long random string (openssl rand -base64 32)
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=https://app.example.com

# Telegram approvals (optional until the bot exists)
TELEGRAM_BOT_TOKEN=
# Chat id that receives approval requests (Javad's private chat with the bot)
TELEGRAM_ADMIN_CHAT_ID=
# Comma-separated Telegram user ids allowed to approve
TELEGRAM_ADMIN_USER_IDS=
# Random string; Telegram sends it back on every webhook call
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME

# n8n: every event is also POSTed here (optional)
N8N_EVENTS_WEBHOOK_URL=

# Only for docker-compose.db.yml (local bundled Postgres)
POSTGRES_PASSWORD=CHANGE_ME
SITE_NAME=Legend Partner
